% ==============================================================
% Course Beamer theme — "ink & signal"
% Mirrors the website palette (docs/assets/stylesheets/extra.css).
% Colors come from colors.tex, which the preamble loads first.
% ==============================================================
\mode<presentation>

\RequirePackage{multicol}
\RequirePackage{tikz}
\RequirePackage[most]{tcolorbox}

% ---- Typography ----
\RequirePackage[default]{sourcesanspro}
\RequirePackage[scale=0.88]{sourcecodepro}
\usefonttheme[onlymath]{serif}

\setbeamerfont{frametitle}{size=\large,series=\bfseries}
\setbeamerfont{framesubtitle}{size=\footnotesize,series=\mdseries}
\setbeamerfont{eyebrow}{size=\tiny,series=\bfseries}
\setbeamerfont{footline}{size=\tiny}
\setbeamerfont{section title}{size=\LARGE,series=\bfseries}

% ---- Base colors ----
\setbeamercolor{normal text}{fg=themeink!90}
\setbeamercolor{structure}{fg=main_color}
\setbeamercolor{frametitle}{fg=themeink,bg=}
\setbeamercolor{framesubtitle}{fg=inkmuted}
\setbeamercolor{eyebrow}{fg=signaldark}
\setbeamercolor{footline}{fg=inkmuted}
\setbeamercolor{title}{fg=white}
\setbeamercolor{subtitle}{fg=accentlight}
\setbeamercolor{author}{fg=themeink}
\setbeamercolor{date}{fg=inkmuted}
\setbeamercolor{institute}{fg=inkmuted}
\setbeamercolor{item}{fg=themeteal}
\setbeamercolor{subitem}{fg=inkmuted}
\setbeamercolor{item projected}{fg=white,bg=themeteal}
\setbeamercolor{caption name}{fg=accentdark}
\setbeamercolor{bibliography item}{fg=accentdark}

\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{bibliography item}[text]
\setbeamertemplate{caption}[numbered]

% ---- Lists: small teal squares, numbered teal discs ----
\setbeamertemplate{itemize item}{%
  \raisebox{0.18ex}{\color{themeteal}\rule{0.62ex}{0.62ex}}}
\setbeamertemplate{itemize subitem}{%
  \raisebox{0.32ex}{\color{inkmuted}\rule{0.8ex}{0.14ex}}}
\setbeamertemplate{itemize subsubitem}{\color{inkmuted}\tiny$\circ$}
\setbeamertemplate{enumerate item}[circle]
\setbeamertemplate{enumerate subitem}[circle]
\setbeamertemplate{sections/subsections in toc}[circle]

% ---- Frame title: section eyebrow, title, short coral rule ----
\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \vskip7pt
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=0.55cm,rightskip=0.55cm plus 1fil]{frametitle}%
    \ifx\secname\@empty\else
      {\usebeamerfont{eyebrow}\usebeamercolor[fg]{eyebrow}%
        \MakeUppercase{\insertsectionhead}\par}%
      \vskip2pt
    \fi
    {\usebeamerfont{frametitle}\strut\insertframetitle\strut\par}%
    \ifx\beamer@framesubtitle\@empty\else
      {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\par}%
    \fi
    \vskip3pt
    {\color{signal}\rule{0.9cm}{1.2pt}}%
  \end{beamercolorbox}%
  \vskip1pt
}
\setbeamertemplate{headline}{}
\setbeamertemplate{sidebar right}{}

% ---- Footline: hairline, short title left, logo + page number right ----
\newcommand{\frameofframes}{/}
\newcommand{\setframeofframes}[1]{\renewcommand{\frameofframes}{#1}}
\setbeamertemplate{footline}{%
  \leavevmode
  \hbox to \paperwidth{%
    \hskip0.55cm
    \vbox{%
      \hsize=\dimexpr\paperwidth-1.1cm\relax
      {\color{panelborder}\hrule height 0.4pt}%
      \vskip3.5pt
      \hbox to \hsize{%
        \usebeamerfont{footline}\usebeamercolor[fg]{footline}%
        \insertshorttitle
        \hfill
        \insertlogo
        \hskip8pt
        {\usebeamerfont{footline}\bfseries\color{themeteal}\insertframenumber}%
        {\usebeamerfont{footline}\color{inkmuted}\,\frameofframes\,\inserttotalframenumber}%
      }%
      \vskip5pt
    }%
    \hss
  }%
}

% ---- Blocks: tinted panel, colored left rule, colored title text ----
\newtcolorbox{coursebox}[2]{%
  enhanced, breakable=false,
  colback=#1!5!white, colframe=#1, coltext=themeink!90,
  boxrule=0pt, leftrule=2pt, arc=1.5pt, outer arc=1.5pt,
  left=5pt, right=5pt, top=3pt, bottom=4pt,
  before skip=5pt, after skip=5pt,
  fontupper=\small,
  before upper={%
    \raggedright
    \def\@coursetitle{#2}%
    \ifx\@coursetitle\@empty\else
      {\normalsize\bfseries\color{#1}#2\par}\vskip2pt
    \fi}%
}
\setbeamertemplate{block begin}{\begin{coursebox}{main_color}{\insertblocktitle}}
\setbeamertemplate{block end}{\end{coursebox}}
\setbeamertemplate{block example begin}{\begin{coursebox}{themeteal}{\insertblocktitle}}
\setbeamertemplate{block example end}{\end{coursebox}}
\setbeamertemplate{block alerted begin}{\begin{coursebox}{leafred}{\insertblocktitle}}
\setbeamertemplate{block alerted end}{\end{coursebox}}

% ---- Title page: ink band with signature rule, logos on white ----
\def\course@titlelogos{}
\newcommand{\settitlelogos}[1]{\def\course@titlelogos{#1}}
\def\course@tagline{}
\newcommand{\settitletagline}[1]{\def\course@tagline{#1}}

\defbeamertemplate*{title page}{course}[1][]{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[themeink] (current page.north west) rectangle
      ([yshift=-0.56\paperheight]current page.north east);
    \shade[left color=themeteal,right color=signal]
      ([yshift=-0.56\paperheight]current page.north west) rectangle
      ([yshift=-0.56\paperheight-1.4pt]current page.north east);
    \node[anchor=north west,inner sep=0pt,text width=\paperwidth-2.2cm,align=left]
      at ([xshift=1.1cm,yshift=-0.9cm]current page.north west)
      {{\usebeamerfont{eyebrow}\color{signal}\MakeUppercase{\course@tagline}}};
    \node[anchor=south west,inner sep=0pt,text width=\paperwidth-2.2cm,align=left]
      at ([xshift=1.1cm,yshift=-0.56\paperheight+0.55cm]current page.north west)
      {\usebeamerfont{title}\usebeamercolor[fg]{title}\raggedright\inserttitle\par};
    \node[anchor=north west,inner sep=0pt,align=left]
      at ([xshift=1.1cm,yshift=-0.56\paperheight-0.55cm]current page.north west)
      {{\usebeamerfont{author}\usebeamercolor[fg]{author}\bfseries\insertauthor}\\[2pt]
       {\usebeamerfont{date}\small\usebeamercolor[fg]{date}\insertinstitute\ \textperiodcentered\ \insertdate}};
    \node[anchor=south east,inner sep=0pt]
      at ([xshift=-0.9cm,yshift=0.6cm]current page.south east)
      {\course@titlelogos};
  \end{tikzpicture}%
}

% ---- Section divider: ink canvas, big number, all parts listed ----
\newcommand{\coursesectiondivider}{%
  {%
    \setbeamertemplate{background canvas}{%
      \begin{tikzpicture}
        \useasboundingbox (0,0) rectangle (\paperwidth,\paperheight);
        \fill[themeink] (0,0) rectangle (\paperwidth,\paperheight);
        \shade[left color=themeteal,right color=signal] (0,0) rectangle (\paperwidth,1.4pt);
      \end{tikzpicture}}
    \setbeamertemplate{footline}{}
    \setbeamercolor{section in toc}{fg=white}
    \setbeamercolor{section in toc shaded}{fg=white!45!themeink}
    \setbeamercolor{section number projected}{fg=themeink,bg=accentlight}
    \setbeamertemplate{section in toc shaded}[default][100]
    \begin{frame}[plain,nologo]
      \vskip0pt plus 1fill
      {\usebeamerfont{eyebrow}\color{signal}PART \insertsectionnumber\par}
      \vskip4pt
      {\usebeamerfont{section title}\color{white}\insertsectionhead\par}
      \vskip10pt
      {\color{white!25!themeink}\rule{\linewidth}{0.4pt}}
      \vskip8pt
      {\small\tableofcontents[currentsection,hideallsubsections]}
      \vskip0pt plus 1.4fill
    \end{frame}
  }%
}

\mode
<all>
